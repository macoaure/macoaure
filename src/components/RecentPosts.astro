---
import { getCollection } from 'astro:content';

const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'pt-br' ? 'pt-br/blog/' : 'blog/';
const posts = (await getCollection('docs', ({ id, data }) => id.startsWith(prefix) && data.date))
	.sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime())
	.slice(0, 3);
const fmt = new Intl.DateTimeFormat(lang === 'pt-br' ? 'pt-BR' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

{posts.length === 0 ? (
	<p class="recent-posts-empty">{lang === 'pt-br' ? 'Em breve.' : 'Coming soon.'}</p>
) : (
<ul class="recent-posts">
	{posts.map((p) => (
		<li>
			<time datetime={p.data.date!.toISOString()}>{fmt.format(p.data.date)}</time>
			<a href={`${base}/${p.id.replace(/\/?index$/, '')}/`}>{p.data.title}</a>
			<span>{p.data.description}</span>
		</li>
	))}
</ul>
)}
